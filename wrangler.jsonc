
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heartmate-ai-companion",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./Public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "heartmate-memory",
      "database_id": "e2047989-57d8-42b7-93e7-287c0ba6ce40"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true
    }
  }
}
